#!/bin/sh
set -e

SB_REPO="shtorm-7/sing-box-extended"
FK_REPO="ushan0v/forkop"
PROXY="http://127.0.0.1:4534"
ARCH="linux-arm64"
TMP_DIR="/tmp/sb_update"
BACKUP_DIR="/tmp/sb_backup"
PERM_BACKUP_DIR="/etc/forkop_backups"
APK_DB="/lib/apk/db/installed"
LANG_FILE="/etc/forkop/mgr.lang"

mkdir -p "$PERM_BACKUP_DIR" /etc/forkop

GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
CYAN='\033[36m'
NC='\033[0m'

if [ -f "$LANG_FILE" ]; then
    APP_LANG=$(cat "$LANG_FILE")
else
    echo "=================================================="
    echo "  Select language / Выберите язык:"
    echo "  1) Русский (Russian)"
    echo "  2) English"
    echo "=================================================="
    printf "Choice / Выбор [1-2] (default 1): "
    read -r L_CHOICE
    case "$L_CHOICE" in
        2|en|EN) APP_LANG="en" ;;
        *) APP_LANG="ru" ;;
    esac
    echo -n "$APP_LANG" > "$LANG_FILE"
fi

t() {
    if [ "$APP_LANG" = "en" ]; then
        echo "$2"
    else
        echo "$1"
    fi
}

toggle_lang() {
    if [ "$APP_LANG" = "en" ]; then
        APP_LANG="ru"
    else
        APP_LANG="en"
    fi
    echo -n "$APP_LANG" > "$LANG_FILE"
}

get_singbox_ver() {
    /usr/bin/sing-box version 2>/dev/null | head -n1 | awk '{print $3}' || echo "$(t "не установлена" "not installed")"
}

get_forkop_ver() {
    uci get forkop.settings.config_version 2>/dev/null || cat /etc/forkop/sing-box-version 2>/dev/null || echo "1.0.5"
}

get_netbird_status() {
    if ip a show wt0 2>/dev/null | grep -q "inet "; then
        printf "${GREEN}UP (wt0)${NC}"
    else
        printf "${RED}DOWN${NC}"
    fi
}

is_proxy_ready() {
    netstat -ln 2>/dev/null | grep -q ":4534 "
}

safe_curl() {
    if is_proxy_ready; then
        curl -SLf -x "$PROXY" --connect-timeout 25 "$@"
        return 0
    fi
    curl -SLf --connect-timeout 25 "$@"
}

sb_rollback() {
    echo ""
    printf "${RED}==================================================${NC}\n"
    printf "${RED}   %s   ${NC}\n" "$(t "[ОШИБКА] Сбой ядра! Запуск автоотката..." "[ERROR] Kernel failure! Rolling back...")"
    printf "${RED}==================================================${NC}\n"
    if [ -f "$BACKUP_DIR/sing-box" ]; then
        cp -f "$BACKUP_DIR/sing-box" /usr/bin/sing-box
        chmod +x /usr/bin/sing-box
    fi
    if [ -f "$BACKUP_DIR/installed.bak" ] && [ -f "$APK_DB" ]; then
        cp -f "$BACKUP_DIR/installed.bak" "$APK_DB"
    fi
    echo -n "$SB_CUR_VER" > /etc/forkop/sing-box-version 2>/dev/null || true
    echo -n "$SB_CUR_VER" > /etc/forkop/subscription-cache/sing-box-version 2>/dev/null || true
    rm -f /tmp/run/forkop/system-info.json 2>/dev/null || true
    rm -rf /tmp/luci-*cache* /tmp/luci-indexcache* 2>/dev/null || true
    /etc/init.d/forkop restart || true
    rm -rf "$TMP_DIR" "$BACKUP_DIR"
    printf "${GREEN}%s${NC}\n" "$(t "Откат завершен. Предыдущая версия ядра восстановлена." "Rollback finished. Previous kernel restored.")"
    exit 1
}

menu_singbox() {
    echo ""
    echo "$(t "Подключение к GitHub..." "Connecting to GitHub...")"

    API_DATA=$(safe_curl -H "User-Agent: OpenWrt-Forkop-Mgr" "https://api.github.com/repos/${SB_REPO}/tags?per_page=10" 2>/dev/null || true)
    RELEASES=$(echo "$API_DATA" | grep '"name":' | grep 'extended' | head -n 3 | sed -e 's/.*"name": *"//' -e 's/".*//')

    if [ -z "$RELEASES" ]; then
        printf "${RED}%s${NC}\n" "$(t "Ошибка: не удалось связаться с GitHub. Проверьте интернет или NetBird." "Error: Failed to reach GitHub. Check internet or NetBird.")"
        return
    fi

    TAG1=$(echo "$RELEASES" | sed -n '1p')
    TAG2=$(echo "$RELEASES" | sed -n '2p')
    TAG3=$(echo "$RELEASES" | sed -n '3p')
    SB_CUR_VER=$(get_singbox_ver)

    fmt_tag() {
        t_val="$1"
        c=$(echo "$t_val" | sed 's/^v//')
        if [ "$c" = "$SB_CUR_VER" ]; then
            echo "$t_val  \033[32m[$(t "текущая" "current")]\033[0m"
        else
            echo "$t_val"
        fi
    }

    echo ""
    echo "=================================================="
    echo "  $(t "Менеджер ядра Sing-Box Extended" "Sing-Box Extended Kernel Manager")"
    echo "=================================================="
    echo "$(t "Текущая версия в системе:" "Current installed version:") $SB_CUR_VER"
    echo ""
    echo "$(t "Доступные версии на GitHub:" "Available versions on GitHub:")"
    [ -n "$TAG1" ] && printf "  1) %b\n" "$(fmt_tag "$TAG1")"
    [ -n "$TAG2" ] && printf "  2) %b\n" "$(fmt_tag "$TAG2")"
    [ -n "$TAG3" ] && printf "  3) %b\n" "$(fmt_tag "$TAG3")"
    echo "  0) $(t "Назад в главное меню" "Back to main menu")"
    echo "=================================================="
    printf "%s: " "$(t "Выберите пункт [0-3]" "Select an option [0-3]")"
    read -r CH

    case "$CH" in
        1) T_TAG="$TAG1" ;;
        2) T_TAG="$TAG2" ;;
        3) T_TAG="$TAG3" ;;
        *) return ;;
    esac

    V_CLEAN=$(echo "$T_TAG" | sed 's/^v//')
    if [ "$SB_CUR_VER" = "$V_CLEAN" ]; then
        echo ""
        echo "$(t "Версия" "Version") $V_CLEAN $(t "уже установлена!" "is already installed!")"
        echo "  1) $(t "Переустановить принудительно (force)" "Force reinstall")"
        echo "  0) $(t "Отмена" "Cancel")"
        printf "%s: " "$(t "Выбор [0-1]" "Choice [0-1]")"
        read -r SCH
        if [ "$SCH" != "1" ]; then
            return
        fi
    fi

    echo ""
    echo "=== [1/5] $(t "Подготовка пространства в ОЗУ" "Preparing workspace in RAM") ==="
    rm -rf "$TMP_DIR" "$BACKUP_DIR"
    mkdir -p "$TMP_DIR" "$BACKUP_DIR"
    cd "$TMP_DIR"

    echo "=== [2/5] $(t "Скачивание UPX-сжатого архива" "Downloading UPX-compressed archive") $T_TAG ==="
    URL="https://github.com/${SB_REPO}/releases/download/${T_TAG}/sing-box-${V_CLEAN}-${ARCH}-compressed.tar.gz"
    if ! safe_curl -o archive.tar.gz "$URL"; then
        printf "${RED}%s${NC}\n" "$(t "Ошибка при скачивании ядра!" "Kernel download failed!")"
        rm -rf "$TMP_DIR" "$BACKUP_DIR"
        return
    fi

    tar -xzf archive.tar.gz
    BIN_FILE=$(find "$TMP_DIR" -type f -name "sing-box" | head -n 1)
    chmod +x "$BIN_FILE"

    echo "=== [3/5] $(t "Самопроверка и контроль памяти" "Self-test & space check") ==="
    TEST_V=$("$BIN_FILE" version | head -n1 | awk '{print $3}')
    if [ "$TEST_V" != "$V_CLEAN" ]; then
        echo "$(t "Бинарник поврежден!" "Binary corrupted!")"
        rm -rf "$TMP_DIR" "$BACKUP_DIR"
        return
    fi

    REQ_SPACE=$(ls -s "$BIN_FILE" | awk '{print $1}')
    AVAIL_SPACE=$(df -k /overlay | tail -n1 | awk '{print $4}')
    CUR_SPACE=$(ls -s /usr/bin/sing-box 2>/dev/null | awk '{print $1}' || echo 0)
    TOTAL_AVAIL=$((AVAIL_SPACE + CUR_SPACE))

    echo "$(t "Размер нового ядра:" "New kernel size:") ${REQ_SPACE}KB | $(t "Доступно с заменой:" "Available with swap:") ${TOTAL_AVAIL}KB"
    if [ "$TOTAL_AVAIL" -lt "$REQ_SPACE" ]; then
        printf "${RED}%s${NC}\n" "$(t "Недостаточно места в /overlay!" "Not enough space in /overlay!")"
        rm -rf "$TMP_DIR" "$BACKUP_DIR"
        return
    fi

    echo "=== [4/5] $(t "Создание резервной копии ядра в ОЗУ" "Creating kernel backup in RAM") ==="
    [ -f /usr/bin/sing-box ] && cp -f /usr/bin/sing-box "$BACKUP_DIR/sing-box"
    [ -f "$APK_DB" ] && cp -f "$APK_DB" "$BACKUP_DIR/installed.bak"

    echo "=== [5/5] $(t "Установка и синхронизация кэша" "Installing & syncing cache") ==="
    /etc/init.d/forkop stop || true
    killall -9 sing-box 2>/dev/null || true
    sleep 1

    rm -f /usr/bin/sing-box
    if ! mv -f "$BIN_FILE" /usr/bin/sing-box || ! chmod +x /usr/bin/sing-box; then
        sb_rollback
    fi
    if ! /usr/bin/sing-box check -c /etc/sing-box/config.json >/dev/null 2>&1; then
        echo "$(t "Новое ядро отклонило конфигурацию Forkop!" "New kernel rejected Forkop config!")"
        sb_rollback
    fi

    mkdir -p /etc/forkop/subscription-cache
    echo -n "$V_CLEAN" > /etc/forkop/sing-box-version
    echo -n "$V_CLEAN" > /etc/forkop/subscription-cache/sing-box-version
    rm -f /tmp/run/forkop/system-info.json 2>/dev/null || true

    if [ -f "$APK_DB" ]; then
        awk -v new_ver="$V_CLEAN" '/^P:sing-box/ { found=1 } found && /^V:/ { $0 = "V:" new_ver; found=0 } { print }' "$APK_DB" > "${APK_DB}.tmp" && mv -f "${APK_DB}.tmp" "$APK_DB"
    fi
    rm -rf /tmp/luci-*cache* /tmp/luci-indexcache* 2>/dev/null || true

    if ! /etc/init.d/forkop start; then
        sb_rollback
    fi
    sleep 3
    if ! pgrep sing-box >/dev/null 2>&1; then
        sb_rollback
    fi

    /usr/bin/forkop list_update_if_due || true
    rm -rf "$TMP_DIR" "$BACKUP_DIR"
    printf "${GREEN}%s $V_CLEAN!${NC}\n" "$(t "Ядро успешно обновлено до версии" "Kernel successfully updated to version")"
}

menu_forkop() {
    echo ""
    echo "$(t "Подключение к GitHub..." "Connecting to GitHub...")"

    API_RESP=$(safe_curl -H "User-Agent: OpenWrt-Forkop-Mgr" "https://api.github.com/repos/${FK_REPO}/releases/latest" 2>/dev/null || true)
    FK_TAG=$(echo "$API_RESP" | grep '"tag_name":' | head -n 1 | sed -e 's/.*"tag_name": *"//' -e 's/".*//')
    [ -z "$FK_TAG" ] && FK_TAG="1.0.5"
    FK_LATEST=$(echo "$FK_TAG" | sed 's/^v//')
    FK_CUR=$(get_forkop_ver)

    echo ""
    echo "=================================================="
    echo "  $(t "Менеджер обновлений Forkop" "Forkop Update Manager")"
    echo "=================================================="
    echo "$(t "Текущая версия Forkop :" "Current Forkop version :") $FK_CUR"
    echo "$(t "Доступная на GitHub   :" "Available on GitHub   :") $FK_LATEST"
    echo "=================================================="

    if [ "$FK_CUR" = "$FK_LATEST" ]; then
        printf "${GREEN}%s${NC}\n\n" "$(t "У вас уже установлена актуальная версия!" "You already have the latest version installed!")"
        echo "  1) $(t "Переустановить принудительно (force)" "Force reinstall")"
        echo "  0) $(t "Назад в главное меню" "Back to main menu")"
        printf "%s: " "$(t "Выбор [0-1]" "Choice [0-1]")"
        read -r FK_CH
        if [ "$FK_CH" != "1" ]; then
            return
        fi
    else
        echo "  1) $(t "Запустить установку пакетов" "Start package installation")"
        echo "  0) $(t "Назад в главное меню" "Back to main menu")"
        printf "%s: " "$(t "Выбор [0-1]" "Choice [0-1]")"
        read -r FK_CH
        if [ "$FK_CH" != "1" ]; then
            return
        fi
    fi

    echo "=== [1/4] $(t "Сохранение конфигурации и подготовка ОЗУ" "Saving config & preparing RAM") ==="
    FK_TMP="/tmp/fk_update"
    rm -rf "$FK_TMP"
    mkdir -p "$FK_TMP"
    cp -f /etc/config/forkop /tmp/forkop_config.bak 2>/dev/null || true

    echo "=== [2/4] $(t "Скачивание пакетов APK" "Downloading APK packages") ==="
    URL_CORE="https://github.com/${FK_REPO}/releases/download/${FK_TAG}/forkop_${FK_LATEST}.apk"
    URL_LUCI="https://github.com/${FK_REPO}/releases/download/${FK_TAG}/luci-app-forkop_${FK_LATEST}.apk"

    echo "Downloading core: $URL_CORE"
    if ! safe_curl -o "$FK_TMP/forkop.apk" "$URL_CORE"; then
        printf "${RED}%s${NC}\n" "$(t "Ошибка скачивания forkop.apk!" "Failed to download forkop.apk!")"
        rm -rf "$FK_TMP"; return
    fi

    echo "Downloading LuCI: $URL_LUCI"
    if ! safe_curl -o "$FK_TMP/luci-app-forkop.apk" "$URL_LUCI"; then
        printf "${RED}%s${NC}\n" "$(t "Ошибка скачивания luci-app-forkop.apk!" "Failed to download luci-app-forkop.apk!")"
        rm -rf "$FK_TMP"; return
    fi

    echo "=== [3/4] $(t "Установка пакетов через apk" "Installing packages via apk") ==="
    /etc/init.d/forkop stop || true

    sed -i '/sing-box-extended/d' /etc/apk/world 2>/dev/null || true

    apk add --allow-untrusted "$FK_TMP/forkop.apk" "$FK_TMP/luci-app-forkop.apk"
    rm -rf "$FK_TMP"

    if [ -f /tmp/forkop_config.bak ]; then
        cp -f /tmp/forkop_config.bak /etc/config/forkop
        rm -f /tmp/forkop_config.bak
    fi

    echo "=== [4/4] Защищенный запуск туннелей и Forkop ==="
    echo "$(t "Перезапуск NetBird..." "Restarting NetBird...")"
    /etc/init.d/netbird restart || true
    echo "$(t "Ожидание интерфейса wt0..." "Waiting for wt0 interface...")"
    W=0
    while [ $W -lt 15 ]; do
        if ip a show wt0 2>/dev/null | grep -q "inet "; then
            printf "${GREEN}%s${NC}\n" "$(t "wt0 поднят и активен!" "wt0 is up and active!")"
            break
        fi
        sleep 1
        W=$((W + 1))
    done

    rm -rf /tmp/luci-*cache* /tmp/luci-indexcache* 2>/dev/null || true
    /etc/init.d/forkop restart || true
    /usr/bin/forkop list_update_if_due || true
    printf "${GREEN}%s${NC}\n" "$(t "Обновление Forkop успешно завершено!" "Forkop update successfully finished!")"
}

menu_backup() {
    while true; do
        echo ""
        echo "=================================================="
        echo "  $(t "Резервное копирование и откат" "Backup & Restore Manager")"
        echo "=================================================="
        echo "  1) $(t "Создать полный бэкап системы" "Create full system backup")"
        echo "  2) $(t "Восстановить из бэкапа (с автооткатом)" "Restore from backup (with auto-rollback)")"
        echo "  3) $(t "Посмотреть содержимое бэкапа" "View backup archive contents")"
        echo "  0) $(t "Назад в главное меню" "Back to main menu")"
        echo "=================================================="
        printf "%s: " "$(t "Выбор [0-3]" "Choice [0-3]")"
        read -r B_CH

        if [ "$B_CH" = "1" ]; then
            TS=$(date +%Y%m%d_%H%M%S)
            FNAME="forkop_backup_${TS}.tar.gz"
            TPERM="$PERM_BACKUP_DIR/$FNAME"
            TTMP="/tmp/$FNAME"
            FLIST=""
            for item in /etc/config/forkop /etc/forkop /etc/netbird /etc/config/netbird /usr/bin/forkop-mgr /etc/config/dhcp /etc/crontabs/root; do
                if [ -e "$item" ]; then
                    FLIST="$FLIST $item"
                fi
            done
            tar -czf "$TPERM" $FLIST
            cp -f "$TPERM" "$TTMP"
            printf "${GREEN}%s: $TPERM${NC}\n" "$(t "Бэкап создан" "Backup created")"
            echo "$(t "Команда для скачивания на любой ПК (в текущую папку терминала):" "Command to download to any PC (to current folder):")"
            echo "scp -O root@192.168.11.1:$TTMP ."
        elif [ "$B_CH" = "2" ]; then
            FOUND=$(find "$PERM_BACKUP_DIR" /tmp -maxdepth 1 -name "forkop_backup_*.tar.gz" 2>/dev/null | sort -u -r)
            if [ -z "$FOUND" ]; then
                printf "${YELLOW}%s${NC}\n" "$(t "Бэкапы не найдены!" "No backups found!")"
                continue
            fi
            echo ""
            echo "$(t "Доступные бэкапы:" "Available backups:")"
            C=0
            for f in $FOUND; do
                C=$((C + 1))
                eval "BF_$C=\"$f\""
                echo "  $C) $f ($(ls -lh "$f" | awk '{print $5}'))"
            done
            echo "  0) $(t "Отмена" "Cancel")"
            printf "%s: " "$(t "Выберите номер [0-$C]" "Select number [0-$C]")"
            read -r SEL
            if [ "$SEL" = "0" ] || [ -z "$SEL" ]; then
                continue
            fi
            eval "CF=\"\$BF_$SEL\""
            if [ ! -f "$CF" ]; then
                echo "$(t "Неверный выбор" "Invalid choice")"
                continue
            fi

            printf "%s $CF? [y/N]: " "$(t "Применить бэкап" "Apply backup")"
            read -r CONF
            if [ "$CONF" != "y" ] && [ "$CONF" != "Y" ] && [ "$CONF" != "yes" ] && [ "$CONF" != "YES" ]; then
                continue
            fi

            echo "$(t "Проверка архива и создание аварийного снимка..." "Checking archive & taking emergency snapshot...")"
            if ! tar -tzf "$CF" >/dev/null 2>&1; then
                echo "$(t "Архив поврежден!" "Archive corrupted!")"
                continue
            fi
            SNAP="/tmp/pre_restore_snap"
            rm -rf "$SNAP"
            mkdir -p "$SNAP"
            if [ -f /etc/config/forkop ]; then cp -f /etc/config/forkop "$SNAP/"; fi
            if [ -d /etc/netbird ]; then cp -rf /etc/netbird "$SNAP/"; fi

            echo "$(t "Распаковка..." "Extracting...")"
            if ! tar -xzf "$CF" -C /; then
                echo "$(t "Ошибка распаковки! Откат..." "Extraction error! Rolling back...")"
                if [ -f "$SNAP/forkop" ]; then cp -f "$SNAP/forkop" /etc/config/forkop; fi
                continue
            fi
            if [ -f /usr/bin/forkop-mgr ]; then chmod +x /usr/bin/forkop-mgr; fi

            echo "$(t "Перезапуск NetBird и Forkop..." "Restarting NetBird & Forkop...")"
            /etc/init.d/netbird restart || true
            sleep 2
            /etc/init.d/forkop restart || true
            rm -rf "$SNAP"
            printf "${GREEN}%s${NC}\n" "$(t "Система успешно восстановлена!" "System successfully restored!")"
        elif [ "$B_CH" = "3" ]; then
            FOUND=$(find "$PERM_BACKUP_DIR" /tmp -maxdepth 1 -name "forkop_backup_*.tar.gz" 2>/dev/null | sort -u -r)
            if [ -z "$FOUND" ]; then
                printf "${YELLOW}%s${NC}\n" "$(t "Бэкапы не найдены!" "No backups found!")"
                continue
            fi
            C=0
            for f in $FOUND; do
                C=$((C + 1))
                eval "BF_$C=\"$f\""
                echo "  $C) $f"
            done
            printf "%s: " "$(t "Выберите номер [0-$C]" "Select number [0-$C]")"
            read -r SEL
            if [ "$SEL" = "0" ] || [ -z "$SEL" ]; then
                continue
            fi
            eval "CF=\"\$BF_$SEL\""
            tar -ztvf "$CF"
        else
            break
        fi
    done
}

menu_diag() {
    echo ""
    echo "=== $(t "Диагностика и мягкий перезапуск" "Diagnostics & Soft Restart") ==="
    echo "1. $(t "Остановка Forkop (возврат прямого DNS)..." "Stopping Forkop (restoring direct DNS)...")"
    /etc/init.d/forkop stop || true
    echo "2. Перезапуск NetBird..."
    /etc/init.d/netbird restart || true
    echo "3. Ожидание интерфейса wt0..."
    W=0
    while [ $W -lt 15 ]; do
        if ip a show wt0 2>/dev/null | grep -q "inet "; then
            printf "${GREEN}%s${NC}\n" "$(t "wt0 активен!" "wt0 is active!")"
            break
        fi
        sleep 1
        W=$((W + 1))
    done
    echo "4. Чистый запуск Forkop..."
    /etc/init.d/forkop restart || true
    echo "5. Принудительное обновление списков..."
    /usr/bin/forkop list_update_if_due || true
    /usr/bin/forkop subscription_update_if_due || true
    printf "${GREEN}%s${NC}\n" "$(t "Перезапуск завершен! Туннели и списки синхронизированы." "Restart complete! Tunnels & lists synced.")"
}

while true; do
    echo ""
    printf "${CYAN}========================================================${NC}\n"
    printf "${CYAN}             FORKOP CONTROL CENTER                      ${NC}\n"
    printf "${CYAN}========================================================${NC}\n"
    printf "  $(t "Устройство" "Device    ") : Xiaomi AX6000 (OpenWrt 25.12)\n"
    printf "  $(t "Ядро      " "Kernel    ") : Sing-Box \033[32m%s\033[0m\n" "$(get_singbox_ver)"
    printf "  $(t "Forkop    " "Forkop    ") : \033[32m%s\033[0m\n" "$(get_forkop_ver)"
    printf "  $(t "Туннель   " "Tunnel    ") : NetBird %b\n" "$(get_netbird_status)"
    printf "${CYAN}========================================================${NC}\n"
    echo "  1) $(t "Управление ядром Sing-Box (Extended + UPX)" "Sing-Box Extended Kernel Management (UPX)")"
    echo "  2) $(t "Обновление самого Forkop (прямая установка APK)" "Update Forkop (Direct APK installation)")"
    echo "  3) $(t "Резервное копирование и Восстановление" "Backup & Restore Manager")"
    echo "  4) $(t "Быстрый безопасный перезапуск всех служб" "Quick safe restart of all services")"
    echo "  L) $(t "Сменить язык / Switch to English" "Change language / Переключить на Русский")"
    echo "  0) $(t "Выход" "Exit")"
    printf "${CYAN}========================================================${NC}\n"
    printf "%s: " "$(t "Выберите раздел [0-4, L]" "Select a section [0-4, L]")"
    read -r M_CH

    case "$M_CH" in
        1) menu_singbox ;;
        2) menu_forkop ;;
        3) menu_backup ;;
        4) menu_diag ;;
        l|L|д|Д) toggle_lang ;;
        0|"") echo "$(t "Выход." "Exit.")"; exit 0 ;;
        *) echo "$(t "Неверный ввод." "Invalid input.")" ;;
    esac
done
