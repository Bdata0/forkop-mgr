#!/bin/sh

# ============================================================
# Forkop Control Center
# ============================================================
#
# OpenWrt 24.x / 25.x
# Forkop + Sing-Box Extended + NetBird
#
# ============================================================

SB_REPO="shtorm-7/sing-box-extended"
FK_REPO="ushan0v/forkop"

APP_DIR="/etc/forkop"
LANG_FILE="$APP_DIR/mgr.lang"

BACKUP_DIR="/etc/forkop_backups"
TMP_ROOT="/tmp/forkop-mgr"

GITHUB_UA="forkop-mgr/OpenWrt"

GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
CYAN='\033[36m'
BOLD='\033[1m'
NC='\033[0m'

mkdir -p "$APP_DIR"
mkdir -p "$BACKUP_DIR"
mkdir -p "$TMP_ROOT"

APP_LANG="ru"

if [ -f "$LANG_FILE" ]; then
    APP_LANG="$(cat "$LANG_FILE" 2>/dev/null)"
fi

[ "$APP_LANG" = "en" ] || APP_LANG="ru"


# ============================================================
# Localization & UI Helpers
# ============================================================

t() {
    if [ "$APP_LANG" = "en" ]; then
        printf '%s' "$2"
    else
        printf '%s' "$1"
    fi
}

msg_ok() {
    printf "${GREEN}%s${NC}\n" "$1"
}

msg_warn() {
    printf "${YELLOW}%s${NC}\n" "$1"
}

msg_err() {
    printf "${RED}%s${NC}\n" "$1"
}

step_start() {
    printf "  ▶ %-42s " "$1"
}

step_done() {
    printf "${GREEN}[OK]${NC}\n"
}

step_done_info() {
    printf "${GREEN}[OK: %s]${NC}\n" "$1"
}

step_fail() {
    printf "${RED}[FAIL]${NC}\n"
}

toggle_lang() {
    if [ "$APP_LANG" = "en" ]; then
        APP_LANG="ru"
    else
        APP_LANG="en"
    fi

    printf '%s' "$APP_LANG" > "$LANG_FILE"
}

confirm_yes() {
    prompt="$1"
    default="${2:-n}"

    if [ "$default" = "y" ]; then
        disp="[Y/n]"
    else
        disp="[y/N]"
    fi

    printf "%s %s: " "$prompt" "$disp"
    read -r ans

    [ -z "$ans" ] && ans="$default"

    case "$ans" in
        1|[yY]|[yY][eE][sS]|[дД]|[дД][аА])
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}


# ============================================================
# Cleanup & Traps
# ============================================================

cleanup_tmp() {
    rm -rf "$TMP_ROOT"
    mkdir -p "$TMP_ROOT"
}

cleanup_all() {
    end_github_session
    rm -rf "$TMP_ROOT"
}

trap cleanup_all EXIT INT TERM


# ============================================================
# Basic Helpers
# ============================================================

have_cmd() {
    command -v "$1" >/dev/null 2>&1
}

forkop_running() {
    if [ -x /etc/init.d/forkop ]; then
        if /etc/init.d/forkop status >/dev/null 2>&1; then
            return 0
        fi
    fi

    if have_cmd pidof; then
        pidof forkop >/dev/null 2>&1 && return 0
    fi

    return 1
}

wt0_up() {
    ip addr show wt0 2>/dev/null | grep -q 'inet '
}

wait_wt0() {
    timeout="${1:-30}"
    i=0

    printf "  ▶ %s " "$(t "Ожидание интерфейса wt0" "Waiting for wt0 interface")"

    while [ "$i" -lt "$timeout" ]; do
        if wt0_up; then
            printf "${GREEN}[OK: %ss]${NC}\n" "$i"
            return 0
        fi
        sleep 1
        i=$((i + 1))
        printf "."
    done

    printf "${RED}[TIMEOUT]${NC}\n"
    return 1
}


# ============================================================
# Forkop & NetBird Lifecycle
# ============================================================

start_forkop_safe() {
    if ! wt0_up; then
        if [ -x /etc/init.d/netbird ]; then
            /etc/init.d/netbird restart >/dev/null 2>&1 || true
        fi

        if ! wait_wt0 30; then
            msg_err "$(t \
                "NetBird/wt0 не поднялся. Forkop НЕ будет запущен." \
                "NetBird/wt0 did not come up. Forkop will NOT be started.")"
            return 1
        fi
    fi

    if [ -x /etc/init.d/forkop ]; then
        /etc/init.d/forkop restart >/dev/null 2>&1 || {
            msg_err "$(t \
                "Не удалось запустить Forkop." \
                "Failed to start Forkop.")"
            return 1
        }
    fi

    sleep 2
    return 0
}


# ============================================================
# Single-Session GitHub Management
# ============================================================

GITHUB_SESSION_ACTIVE=0
FORKOP_WAS_STOPPED=0

github_direct_test() {
    if have_cmd curl; then
        curl -4 -fsS -I \
            -H "User-Agent: $GITHUB_UA" \
            --connect-timeout 5 \
            --max-time 8 \
            https://raw.githubusercontent.com/ >/dev/null 2>&1
        return $?
    fi

    if have_cmd wget; then
        wget -4 -q -O /dev/null \
            --timeout=7 \
            https://raw.githubusercontent.com/ >/dev/null 2>&1
        return $?
    fi

    return 1
}

begin_github_session() {
    [ "$GITHUB_SESSION_ACTIVE" = "1" ] && return 0

    if github_direct_test; then
        GITHUB_SESSION_ACTIVE=1
        return 0
    fi

    if forkop_running; then
        FORKOP_WAS_STOPPED=1
        msg_warn "$(t \
            "Временная остановка Forkop для доступа к GitHub..." \
            "Temporarily stopping Forkop for GitHub access...")"
        if [ -x /etc/init.d/forkop ]; then
            /etc/init.d/forkop stop >/dev/null 2>&1 || true
        fi
        sleep 2
    fi

    GITHUB_SESSION_ACTIVE=1
    return 0
}

end_github_session() {
    [ "$GITHUB_SESSION_ACTIVE" = "1" ] || return 0
    GITHUB_SESSION_ACTIVE=0

    if [ "$FORKOP_WAS_STOPPED" = "1" ]; then
        FORKOP_WAS_STOPPED=0
        msg_warn "$(t \
            "Возвращаем Forkop..." \
            "Restoring Forkop...")"
        start_forkop_safe >/dev/null 2>&1 || \
            msg_warn "$(t \
                "Forkop не удалось автоматически запустить." \
                "Forkop could not be started automatically.")"
    fi
}


# ============================================================
# Network Download Engine with Progress Indicators
# ============================================================

# Quiet download for small metadata/JSON files
download_quiet() {
    url="$1"
    output="$2"

    if have_cmd curl; then
        curl -4 -fsSL \
            -H "User-Agent: $GITHUB_UA" \
            --connect-timeout 15 \
            --max-time 60 \
            "$url" -o "$output"
        return $?
    elif have_cmd wget; then
        wget -4 -q \
            --timeout=20 \
            -O "$output" "$url"
        return $?
    fi

    return 1
}

# Download with visual progress bar for large files (binaries, APKs)
download_with_progress() {
    url="$1"
    output="$2"

    if have_cmd curl; then
        # curl -# displays a clean, single-line progress bar: [#####....] 100%
        curl -4 -fSL -# \
            -H "User-Agent: $GITHUB_UA" \
            --connect-timeout 15 \
            --max-time 600 \
            "$url" -o "$output"
        return $?
    elif have_cmd wget; then
        wget -4 \
            --timeout=30 \
            -O "$output" "$url"
        return $?
    fi

    return 1
}

github_get() {
    url="$1"
    output="$2"

    begin_github_session

    if download_quiet "$url" "$output" && [ -s "$output" ]; then
        return 0
    fi

    for proxy in "https://ghproxy.net/" "https://gh-proxy.com/"; do
        if download_quiet "${proxy}${url}" "$output" && [ -s "$output" ]; then
            return 0
        fi
    done

    rm -f "$output"
    return 1
}

github_download() {
    url="$1"
    output="$2"

    begin_github_session

    if download_with_progress "$url" "$output" && [ -s "$output" ]; then
        return 0
    fi

    msg_warn "$(t \
        "Прямая загрузка не удалась. Подключение через зеркало обхода..." \
        "Direct download failed. Connecting via bypass mirror...")"

    for proxy in "https://ghproxy.net/" "https://gh-proxy.com/"; do
        if download_with_progress "${proxy}${url}" "$output" && [ -s "$output" ]; then
            return 0
        fi
    done

    rm -f "$output"
    return 1
}


# ============================================================
# JSON & Version Helpers
# ============================================================

json_values() {
    json="$1"
    key="$2"

    printf '%s\n' "$json" |
        grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" 2>/dev/null |
        sed 's/.*:[[:space:]]*"//; s/"$//'
}

release_tags() {
    file="$1"
    json_values "$(cat "$file")" "tag_name" | head -n 3
}

asset_urls() {
    file="$1"
    json_values "$(cat "$file")" "browser_download_url"
}

find_asset() {
    file="$1"
    filename="$2"

    asset_urls "$file" | grep "/${filename}$" | head -n 1
}

get_singbox_ver() {
    if [ -x /usr/bin/sing-box ]; then
        ver="$(/usr/bin/sing-box version 2>/dev/null | head -n 1 | awk '{print $3}')"
        if [ -n "$ver" ]; then
            printf '%s' "$ver"
            return
        fi
    fi
    printf '%s' "$(t "не установлена" "not installed")"
}

get_forkop_ver() {
    v="$(uci get forkop.settings.config_version 2>/dev/null)"
    if [ -n "$v" ]; then
        printf '%s' "$v"
        return
    fi

    if have_cmd apk; then
        v="$(apk info -v 2>/dev/null | grep '^forkop-' | head -n 1 | sed 's/^forkop-//')"
        if [ -n "$v" ]; then
            printf '%s' "$v"
            return
        fi
    fi

    printf '%s' "$(t "неизвестно" "unknown")"
}

device_name() {
    model=""
    if [ -f /tmp/sysinfo/model ]; then
        model="$(cat /tmp/sysinfo/model 2>/dev/null)"
    fi
    if [ -z "$model" ] && [ -f /etc/board.json ] && have_cmd jsonfilter; then
        model="$(jsonfilter -i /etc/board.json -e '@.model.name' 2>/dev/null)"
    fi
    if [ -z "$model" ]; then
        model="$(uci get system.@system[0].hostname 2>/dev/null)"
    fi
    [ -z "$model" ] && model="OpenWrt"

    owrt_ver=""
    if [ -f /etc/openwrt_release ]; then
        owrt_ver="$(grep -o "DISTRIB_RELEASE='[^']*'" /etc/openwrt_release 2>/dev/null | cut -d"'" -f2)"
        [ -z "$owrt_ver" ] && owrt_ver="$(grep -o 'DISTRIB_RELEASE="[^"]*"' /etc/openwrt_release 2>/dev/null | cut -d'"' -f2)"
    fi

    if [ -n "$owrt_ver" ]; then
        printf '%s (OpenWrt %s)' "$model" "$owrt_ver"
    else
        printf '%s' "$model"
    fi
}

clear_luci_cache() {
    rm -rf /tmp/luci-*cache* /tmp/luci-indexcache* 2>/dev/null || true
    rm -f /tmp/run/forkop/system-info.json 2>/dev/null || true
}

sync_singbox_version() {
    version="$1"
    mkdir -p /etc/forkop/subscription-cache
    printf '%s' "$version" > /etc/forkop/sing-box-version
    printf '%s' "$version" > /etc/forkop/subscription-cache/sing-box-version
}


# ============================================================
# Sing-Box Manager
# ============================================================

singbox_rollback() {
    old_version="$1"
    old_running="$2"

    echo ""
    msg_err "$(t \
        "Ошибка! Выполняется автоматический откат..." \
        "Error! Performing automatic rollback...")"

    if [ -x /etc/init.d/forkop ]; then
        /etc/init.d/forkop stop >/dev/null 2>&1 || true
    fi

    killall -9 sing-box 2>/dev/null || true

    if [ -f "$TMP_ROOT/singbox/backup/sing-box" ]; then
        cp -f "$TMP_ROOT/singbox/backup/sing-box" /usr/bin/sing-box
        chmod +x /usr/bin/sing-box
    fi

    if [ -n "$old_version" ]; then
        sync_singbox_version "$old_version"
    fi

    clear_luci_cache

    if [ "$old_running" = "1" ]; then
        start_forkop_safe >/dev/null 2>&1 || true
    fi

    msg_ok "$(t \
        "Откат завершён. Предыдущее ядро восстановлено." \
        "Rollback complete. Previous kernel restored.")"

    return 1
}

menu_singbox() {
    cleanup_tmp

    SB_TMP="$TMP_ROOT/singbox"
    mkdir -p "$SB_TMP/work" "$SB_TMP/backup"

    echo ""
    step_start "$(t "Запрос списка релизов на GitHub..." "Querying GitHub releases...")"

    releases="$SB_TMP/releases.json"

    if ! github_get "https://api.github.com/repos/${SB_REPO}/releases?per_page=10" "$releases"; then
        step_fail
        msg_err "$(t \
            "Не удалось получить список релизов Sing-Box." \
            "Failed to retrieve Sing-Box releases.")"
        end_github_session
        return
    fi
    step_done

    tags="$(release_tags "$releases")"

    if [ -z "$tags" ]; then
        msg_err "$(t \
            "GitHub API не вернул релизы." \
            "GitHub API returned no releases.")"
        end_github_session
        return
    fi

    TAG1="$(printf '%s\n' "$tags" | sed -n '1p')"
    TAG2="$(printf '%s\n' "$tags" | sed -n '2p')"
    TAG3="$(printf '%s\n' "$tags" | sed -n '3p')"

    current="$(get_singbox_ver)"

    echo ""
    echo "=================================================="
    echo "  $(t "Менеджер ядра Sing-Box Extended" "Sing-Box Extended Kernel Manager")"
    echo "=================================================="
    echo "$(t "Текущая версия:" "Current version:") $current"
    echo ""
    echo "$(t "Последние версии на GitHub:" "Latest GitHub releases:")"

    n=1
    for tag in "$TAG1" "$TAG2" "$TAG3"; do
        [ -z "$tag" ] && continue
        clean="$(printf '%s' "$tag" | sed 's/^v//')"
        suffix=""
        if [ "$clean" = "$current" ]; then
            suffix="  [$(t "текущая" "current")]"
        fi
        printf "  %s) %s%s\n" "$n" "$tag" "$suffix"
        n=$((n + 1))
    done

    echo "  0) $(t "Назад" "Back")"
    echo "=================================================="

    printf "%s: " "$(t "Выберите пункт [0-3]" "Select an option [0-3]")"
    read -r choice

    case "$choice" in
        1) tag="$TAG1" ;;
        2) tag="$TAG2" ;;
        3) tag="$TAG3" ;;
        *) end_github_session; return ;;
    esac

    [ -n "$tag" ] || { end_github_session; return; }

    version="$(printf '%s' "$tag" | sed 's/^v//')"

    if [ "$version" = "$current" ]; then
        if ! confirm_yes "$(t "Версия уже установлена. Переустановить?" "Version already installed. Reinstall?")"; then
            end_github_session
            return
        fi
    fi

    release="$SB_TMP/release.json"

    echo ""
    step_start "$(t "Получение метаданных релиза..." "Fetching release metadata...")"

    if ! github_get "https://api.github.com/repos/${SB_REPO}/releases/tags/${tag}" "$release"; then
        step_fail
        msg_err "$(t \
            "Не удалось получить информацию о релизе." \
            "Failed to retrieve release information.")"
        end_github_session
        return
    fi
    step_done

    asset_name="sing-box-${version}-linux-arm64-compressed.tar.gz"
    asset_url="$(find_asset "$release" "$asset_name")"

    if [ -z "$asset_url" ]; then
        msg_err "$(t \
            "В релизе не найден ARM64 compressed asset:" \
            "ARM64 compressed asset was not found:")"
        echo "  $asset_name"
        echo ""
        echo "$(t "Доступные assets:" "Available assets:")"
        asset_urls "$release"
        end_github_session
        return
    fi

    archive="$SB_TMP/work/sing-box.tar.gz"

    echo ""
    echo "=== [1/6] $(t "Скачивание ядра Sing-Box" "Downloading Sing-Box kernel") ==="
    echo "  $asset_name"

    if ! github_download "$asset_url" "$archive"; then
        msg_err "$(t \
            "Не удалось скачать архив." \
            "Failed to download archive.")"
        end_github_session
        return
    fi

    end_github_session

    echo ""
    echo "=== [2/6] $(t "Проверка и распаковка" "Verifying & unpacking") ==="
    step_start "$(t "Проверка целостности архива..." "Checking archive integrity...")"

    if ! tar -tzf "$archive" >/dev/null 2>&1; then
        step_fail
        msg_err "$(t \
            "Архив повреждён или имеет неверный формат." \
            "Archive is corrupt or has an invalid format.")"
        return
    fi
    step_done

    rm -rf "$SB_TMP/work/extracted"
    mkdir -p "$SB_TMP/work/extracted"

    step_start "$(t "Распаковка файлов..." "Extracting files...")"
    if ! tar -xzf "$archive" -C "$SB_TMP/work/extracted" 2>/dev/null; then
        step_fail
        msg_err "$(t "Ошибка распаковки." "Extraction failed.")"
        return
    fi
    step_done

    bin_file="$(find "$SB_TMP/work/extracted" -type f -name sing-box 2>/dev/null | head -n 1)"

    if [ -z "$bin_file" ]; then
        msg_err "$(t \
            "В архиве отсутствует бинарник sing-box." \
            "Archive does not contain sing-box binary.")"
        return
    fi

    chmod +x "$bin_file"

    echo ""
    echo "=== [3/6] $(t "Проверка бинарника" "Binary validation") ==="
    step_start "$(t "Проверка версии бинарника..." "Checking binary version...")"

    test_version="$("$bin_file" version 2>/dev/null | head -n 1 | awk '{print $3}')"

    if [ "$test_version" != "$version" ]; then
        step_fail
        msg_err "$(t \
            "Версия бинарника не совпадает с выбранным релизом." \
            "Binary version does not match selected release.")"
        echo "Expected: $version"
        echo "Actual:   $test_version"
        return
    fi
    step_done_info "$test_version"

    echo ""
    echo "=== [4/6] $(t "Проверка свободного места" "Checking free space") ==="

    new_size_kb="$(ls -s "$bin_file" 2>/dev/null | awk '{print $1}')"
    old_size_kb="$(ls -s /usr/bin/sing-box 2>/dev/null | awk '{print $1}')"
    free_kb="$(df -k /overlay 2>/dev/null | tail -n 1 | awk '{print $4}')"

    [ -n "$new_size_kb" ] || new_size_kb=0
    [ -n "$old_size_kb" ] || old_size_kb=0
    [ -n "$free_kb" ] || free_kb=0

    available_after_replace=$((free_kb + old_size_kb))

    step_start "$(t "Проверка места в /overlay..." "Checking /overlay free space...")"
    if [ "$available_after_replace" -lt "$new_size_kb" ]; then
        step_fail
        msg_err "$(t \
            "Недостаточно места в /overlay." \
            "Not enough space in /overlay.")"
        echo "Need:      ${new_size_kb} KB"
        echo "Available: ${available_after_replace} KB"
        return
    fi
    step_done_info "Need: ${new_size_kb}KB, Avail: ${available_after_replace}KB"

    echo ""
    echo "=== [5/6] $(t "Создание RAM snapshot" "Creating RAM snapshot") ==="
    step_start "$(t "Резервная копия текущего ядра..." "Backing up current kernel...")"

    old_running=0
    if forkop_running; then
        old_running=1
    fi

    if [ -f /usr/bin/sing-box ]; then
        cp -f /usr/bin/sing-box "$SB_TMP/backup/sing-box" || {
            step_fail
            msg_err "$(t \
                "Не удалось сохранить старое ядро." \
                "Failed to back up current kernel.")"
            return
        }
    fi
    step_done

    echo ""
    echo "=== [6/6] $(t "Установка и проверка запуска" "Installing and checking startup") ==="

    step_start "$(t "Остановка старого процесса..." "Stopping old process...")"
    if [ -x /etc/init.d/forkop ]; then
        /etc/init.d/forkop stop >/dev/null 2>&1 || true
    fi
    killall -9 sing-box 2>/dev/null || true
    sleep 1
    step_done

    step_start "$(t "Замена бинарного файла..." "Replacing binary file...")"
    if ! cp -f "$bin_file" /usr/bin/sing-box; then
        step_fail
        singbox_rollback "$current" "$old_running"
        return
    fi
    chmod +x /usr/bin/sing-box
    step_done

    sync_singbox_version "$version"
    clear_luci_cache

    if [ "$old_running" = "1" ]; then
        step_start "$(t "Запуск службы Forkop..." "Starting Forkop service...")"
        if ! start_forkop_safe >/dev/null 2>&1; then
            step_fail
            msg_err "$(t \
                "Forkop не удалось запустить после обновления." \
                "Forkop failed to start after update.")"
            singbox_rollback "$current" "$old_running"
            return
        fi
        step_done

        # Animated check loop for sing-box process
        printf "  ▶ %s " "$(t "Ожидание запуска sing-box" "Waiting for sing-box startup")"
        sb_started=0
        for i in $(seq 1 10); do
            if pidof sing-box >/dev/null 2>&1 || pgrep -f sing-box >/dev/null 2>&1; then
                sb_started=1
                printf "${GREEN}[OK: %ss]${NC}\n" "$i"
                break
            fi
            sleep 1
            printf "."
        done

        if [ "$sb_started" != "1" ]; then
            printf "${RED}[FAIL]${NC}\n"
            msg_err "$(t \
                "Sing-Box не запустился после обновления." \
                "Sing-Box did not start after update.")"
            echo "--- $(t "Диагностические логи" "Diagnostic logs") ---"
            logread 2>/dev/null | grep -iE 'forkop|sing-box' | tail -n 12
            singbox_rollback "$current" "$old_running"
            return
        fi
    fi

    echo ""
    msg_ok "$(t \
        "Sing-Box успешно обновлён до" \
        "Sing-Box successfully updated to") $version"

    rm -rf "$SB_TMP"
}


# ============================================================
# Forkop Update Manager
# ============================================================

menu_forkop() {
    cleanup_tmp

    FK_TMP="$TMP_ROOT/forkop"
    mkdir -p "$FK_TMP"

    echo ""
    step_start "$(t "Запрос последнего релиза Forkop..." "Querying latest Forkop release...")"

    latest="$FK_TMP/latest.json"

    if ! github_get "https://api.github.com/repos/${FK_REPO}/releases/latest" "$latest"; then
        step_fail
        msg_err "$(t \
            "Не удалось получить последний релиз Forkop." \
            "Failed to retrieve latest Forkop release.")"
        end_github_session
        return
    fi
    step_done

    tag="$(json_values "$(cat "$latest")" "tag_name" | head -n 1)"

    if [ -z "$tag" ]; then
        msg_err "$(t \
            "GitHub не вернул tag_name." \
            "GitHub did not return tag_name.")"
        end_github_session
        return
    fi

    version="$(printf '%s' "$tag" | sed 's/^v//')"
    current="$(get_forkop_ver)"

    echo ""
    echo "=================================================="
    echo "  $(t "Менеджер обновления Forkop" "Forkop Update Manager")"
    echo "=================================================="
    echo "$(t "Текущая версия:" "Current version:") $current"
    echo "$(t "Последняя версия:" "Latest version:") $version"
    echo "=================================================="

    if [ "$current" = "$version" ]; then
        if ! confirm_yes "$(t "Версия уже актуальна. Переустановить?" "Version is already current. Reinstall?")"; then
            end_github_session
            return
        fi
    else
        echo "  1) $(t "Установить обновление" "Install update")"
        echo "  0) $(t "Назад" "Back")"

        printf "%s: " "$(t "Выбор" "Choice")"
        read -r choice

        [ "$choice" = "1" ] || { end_github_session; return; }
    fi

    release="$FK_TMP/release.json"

    echo ""
    step_start "$(t "Получение метаданных релиза..." "Fetching release metadata...")"

    if ! github_get "https://api.github.com/repos/${FK_REPO}/releases/tags/${tag}" "$release"; then
        step_fail
        msg_err "$(t \
            "Не удалось получить информацию о релизе Forkop." \
            "Failed to retrieve Forkop release information.")"
        end_github_session
        return
    fi
    step_done

    core_name="forkop_${version}.apk"
    luci_name="luci-app-forkop_${version}.apk"

    core_url="$(find_asset "$release" "$core_name")"
    luci_url="$(find_asset "$release" "$luci_name")"

    if [ -z "$core_url" ] || [ -z "$luci_url" ]; then
        msg_err "$(t \
            "Не найдены APK пакеты Forkop в релизе." \
            "Forkop APK packages were not found in release.")"
        end_github_session
        return
    fi

    echo ""
    echo "=== [1/4] $(t "Сохранение конфигурации" "Backing up configuration") ==="
    step_start "$(t "Резервная копия forkop.config..." "Backing up forkop.config...")"

    if [ -f /etc/config/forkop ]; then
        cp -f /etc/config/forkop "$FK_TMP/forkop.config" || {
            step_fail
            msg_err "$(t \
                "Не удалось сохранить конфигурацию Forkop." \
                "Failed to back up Forkop configuration.")"
            end_github_session
            return
        }
    fi
    step_done

    echo ""
    echo "=== [2/4] $(t "Скачивание пакетов" "Downloading packages") ==="

    core_apk="$FK_TMP/$core_name"
    luci_apk="$FK_TMP/$luci_name"

    echo "  $core_name"
    if ! github_download "$core_url" "$core_apk"; then
        msg_err "$(t "Не удалось скачать forkop APK." "Failed to download Forkop APK.")"
        end_github_session
        return
    fi

    echo "  $luci_name"
    if ! github_download "$luci_url" "$luci_apk"; then
        msg_err "$(t "Не удалось скачать luci-app-forkop APK." "Failed to download luci-app-forkop APK.")"
        end_github_session
        return
    fi

    end_github_session

    echo ""
    echo "=== [3/4] $(t "Установка через apk" "Installing with apk") ==="
    step_start "$(t "Остановка службы..." "Stopping service...")"
    if [ -x /etc/init.d/forkop ]; then
        /etc/init.d/forkop stop >/dev/null 2>&1 || true
    fi
    step_done

    step_start "$(t "Установка пакетов apk..." "Installing apk packages...")"
    if ! apk add --allow-untrusted "$core_apk" "$luci_apk" >/dev/null 2>&1; then
        step_fail
        msg_err "$(t \
            "apk не смог установить пакеты." \
            "apk failed to install packages.")"

        if [ -f "$FK_TMP/forkop.config" ]; then
            cp -f "$FK_TMP/forkop.config" /etc/config/forkop
        fi

        start_forkop_safe >/dev/null 2>&1 || true
        return
    fi
    step_done

    echo ""
    echo "=== [4/4] $(t "Восстановление и запуск" "Restoring & starting") ==="

    if [ -f "$FK_TMP/forkop.config" ]; then
        cp -f "$FK_TMP/forkop.config" /etc/config/forkop
    fi

    clear_luci_cache

    step_start "$(t "Безопасный запуск Forkop..." "Safe starting Forkop...")"
    if ! start_forkop_safe >/dev/null 2>&1; then
        step_fail
        msg_err "$(t \
            "Forkop установлен, но безопасный запуск не удался." \
            "Forkop was installed, but safe startup failed.")"
        return
    fi
    step_done

    echo ""
    msg_ok "$(t \
        "Forkop успешно обновлён до" \
        "Forkop successfully updated to") $version"
}


# ============================================================
# Backup & Restore
# ============================================================

backup_create() {
    timestamp="$(date +%Y%m%d_%H%M%S)"
    filename="forkop_backup_${timestamp}.tar.gz"

    permanent="$BACKUP_DIR/$filename"
    temporary="/tmp/$filename"
    list="$TMP_ROOT/backup.list"

    : > "$list"

    for item in \
        /etc/config/forkop \
        /etc/forkop \
        /etc/netbird \
        /etc/config/netbird \
        /etc/config/dhcp \
        /etc/crontabs/root \
        /usr/bin/forkop-mgr
    do
        if [ -e "$item" ]; then
            printf '%s\n' "$item" >> "$list"
        fi
    done

    echo ""
    step_start "$(t "Создание архива конфигураций..." "Creating config archive...")"

    if ! tar -czf "$permanent" -T "$list" 2>/dev/null; then
        step_fail
        rm -f "$permanent"
        msg_err "$(t "Не удалось создать бэкап." "Failed to create backup.")"
        return
    fi
    step_done

    cp -f "$permanent" "$temporary" 2>/dev/null || true

    echo ""
    msg_ok "$(t "Бэкап создан:" "Backup created:")"
    echo "  $permanent"
    echo ""
    echo "$(t "Команда для скачивания на ПК:" "Download command for PC:")"
    echo "  scp -O root@192.168.11.1:$temporary ."
}

backup_list() {
    find "$BACKUP_DIR" /tmp \
        -maxdepth 1 \
        -type f \
        -name 'forkop_backup_*.tar.gz' \
        2>/dev/null |
    awk -F/ '!seen[$NF]++' |
    sort -r
}

backup_restore() {
    files="$(backup_list)"

    if [ -z "$files" ]; then
        msg_warn "$(t "Бэкапы не найдены." "No backups found.")"
        return
    fi

    echo ""
    echo "$(t "Доступные бэкапы:" "Available backups:")"

    n=0
    for file in $files; do
        n=$((n + 1))
        eval "BACKUP_$n=\"\$file\""
        size="$(ls -lh "$file" 2>/dev/null | awk '{print $5}')"
        echo "  $n) $file ($size)"
    done

    echo "  0) $(t "Отмена" "Cancel")"

    printf "%s [0-%s]: " "$(t "Выберите бэкап" "Select backup")" "$n"
    read -r choice

    case "$choice" in
        ''|*[!0-9]*) return ;;
    esac

    [ "$choice" = "0" ] && return
    if [ "$choice" -lt 1 ] || [ "$choice" -gt "$n" ]; then
        msg_err "$(t "Неверный выбор." "Invalid selection.")"
        return
    fi

    eval "selected=\${BACKUP_$choice}"

    if [ ! -f "$selected" ]; then
        msg_err "$(t "Неверный выбор." "Invalid selection.")"
        return
    fi

    if ! confirm_yes "$(t "Восстановить $selected?" "Restore $selected?")"; then
        return
    fi

    step_start "$(t "Проверка целостности архива..." "Checking archive integrity...")"
    if ! tar -tzf "$selected" >/dev/null 2>&1; then
        step_fail
        msg_err "$(t "Архив повреждён." "Archive is corrupt.")"
        return
    fi
    step_done

    restore_tmp="$TMP_ROOT/restore"
    mkdir -p "$restore_tmp"

    current_list="$restore_tmp/current.list"
    pre_restore="$restore_tmp/pre_restore.tar.gz"

    : > "$current_list"

    for item in \
        /etc/config/forkop \
        /etc/forkop \
        /etc/netbird \
        /etc/config/netbird \
        /etc/config/dhcp \
        /etc/crontabs/root \
        /usr/bin/forkop-mgr
    do
        if [ -e "$item" ]; then
            printf '%s\n' "$item" >> "$current_list"
        fi
    done

    step_start "$(t "Создание аварийного snapshot..." "Creating rollback snapshot...")"
    if ! tar -czf "$pre_restore" -T "$current_list" 2>/dev/null; then
        step_fail
        msg_err "$(t \
            "Не удалось создать аварийный snapshot." \
            "Failed to create emergency snapshot.")"
        return
    fi
    step_done

    step_start "$(t "Остановка текущей службы..." "Stopping current service...")"
    if [ -x /etc/init.d/forkop ]; then
        /etc/init.d/forkop stop >/dev/null 2>&1 || true
    fi
    step_done

    step_start "$(t "Восстановление файлов из архива..." "Restoring files from archive...")"
    if ! tar -xzf "$selected" -C / 2>/dev/null; then
        step_fail
        msg_err "$(t \
            "Ошибка восстановления. Выполняется rollback." \
            "Restore failed. Performing rollback.")"
        tar -xzf "$pre_restore" -C / >/dev/null 2>&1 || true
        chmod +x /usr/bin/forkop-mgr 2>/dev/null || true
        start_forkop_safe >/dev/null 2>&1 || true
        return
    fi
    chmod +x /usr/bin/forkop-mgr 2>/dev/null || true
    step_done

    step_start "$(t "Проверка туннеля NetBird..." "Checking NetBird tunnel...")"
    if ! wt0_up; then
        if [ -x /etc/init.d/netbird ]; then
            /etc/init.d/netbird restart >/dev/null 2>&1 || true
        fi

        if ! wait_wt0 30; then
            step_fail
            msg_err "$(t \
                "NetBird не поднялся. Выполняется rollback." \
                "NetBird did not come up. Performing rollback.")"
            tar -xzf "$pre_restore" -C / >/dev/null 2>&1 || true
            chmod +x /usr/bin/forkop-mgr 2>/dev/null || true
            start_forkop_safe >/dev/null 2>&1 || true
            return
        fi
    fi
    step_done

    step_start "$(t "Запуск восстановленной службы..." "Starting restored service...")"
    if ! start_forkop_safe >/dev/null 2>&1; then
        step_fail
        msg_err "$(t \
            "Forkop не запустился. Выполняется rollback." \
            "Forkop failed to start. Performing rollback.")"
        /etc/init.d/forkop stop >/dev/null 2>&1 || true
        tar -xzf "$pre_restore" -C / >/dev/null 2>&1 || true
        chmod +x /usr/bin/forkop-mgr 2>/dev/null || true
        start_forkop_safe >/dev/null 2>&1 || true
        return
    fi
    step_done

    echo ""
    msg_ok "$(t \
        "Система успешно восстановлена." \
        "System successfully restored.")"
}

backup_menu() {
    while true; do
        echo ""
        echo "=================================================="
        echo "  $(t "Резервное копирование и восстановление" "Backup & Restore")"
        echo "=================================================="
        echo "  1) $(t "Создать полный бэкап" "Create full backup")"
        echo "  2) $(t "Восстановить бэкап с rollback" "Restore backup with rollback")"
        echo "  3) $(t "Показать содержимое бэкапа" "Show backup contents")"
        echo "  0) $(t "Назад" "Back")"
        echo "=================================================="

        printf "%s: " "$(t "Выбор [0-3]" "Choice [0-3]")"
        read -r choice

        case "$choice" in
            1)
                backup_create
                ;;
            2)
                backup_restore
                ;;
            3)
                files="$(backup_list)"
                [ -n "$files" ] || {
                    msg_warn "$(t "Бэкапы не найдены." "No backups found.")"
                    continue
                }

                echo ""
                n=0
                for file in $files; do
                    n=$((n + 1))
                    eval "BACKUP_$n=\"\$file\""
                    echo "  $n) $file"
                done

                echo "  0) $(t "Отмена" "Cancel")"
                printf "%s: " "$(t "Выбор" "Choice")"
                read -r choice

                case "$choice" in
                    ''|*[!0-9]*) continue ;;
                esac

                [ "$choice" = "0" ] && continue
                if [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ]; then
                    eval "selected=\${BACKUP_$choice}"
                    [ -f "$selected" ] && tar -ztvf "$selected" 2>/dev/null
                fi
                ;;
            *)
                return
                ;;
        esac
    done
}


# ============================================================
# Diagnostics
# ============================================================

menu_diag() {
    echo ""
    echo "=================================================="
    echo "  $(t "Диагностика и безопасный перезапуск" "Diagnostics & Safe Restart")"
    echo "=================================================="

    step_start "1. $(t "Остановка Forkop..." "Stopping Forkop...")"
    /etc/init.d/forkop stop >/dev/null 2>&1 || true
    step_done

    step_start "2. $(t "Перезапуск NetBird..." "Restarting NetBird...")"
    /etc/init.d/netbird restart >/dev/null 2>&1 || true
    step_done

    echo "3. $(t "Ожидание туннеля wt0..." "Waiting for wt0 tunnel...")"
    if ! wait_wt0 30; then
        msg_err "$(t "wt0 не поднялся. Forkop не будет запущен." "wt0 did not come up. Forkop will not be started.")"
        return
    fi

    step_start "4. $(t "Запуск Forkop..." "Starting Forkop...")"
    if ! start_forkop_safe >/dev/null 2>&1; then
        step_fail
        msg_err "$(t "Forkop не удалось запустить." "Forkop failed to start.")"
        return
    fi
    step_done

    step_start "5. $(t "Обновление списков и подписок..." "Refreshing lists and subscriptions...")"
    if [ -x /usr/bin/forkop ]; then
        /usr/bin/forkop list_update_if_due >/dev/null 2>&1 || true
        /usr/bin/forkop subscription_update_if_due >/dev/null 2>&1 || true
    fi
    step_done

    clear_luci_cache

    echo ""
    msg_ok "$(t "Безопасный перезапуск завершён." "Safe restart completed.")"
}


